---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import Timeline from '../components/Timeline.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, locale, t } from '../i18n';

const allProjects = (await getCollection('projects')).sort((a, b) => {
  const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
  return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
});
const projects = allProjects.slice(0, 3);
const latestProject = allProjects[0];

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 5);

const monthYear = (date: Date) =>
  new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(date);

const timelineItems = posts.map((post, index) => ({
  dateLabel: formatDate(post.data.publishDate, 'short'),
  title: post.data.title,
  description: post.data.description,
  href: withBase(`/blog/${post.id}/`),
  tags: post.data.tags,
  badge: index === 0 ? `Latest · ${monthYear(post.data.publishDate)}` : undefined,
}));

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">AI/ML Engineer / LLM &amp; Agentic AI</p>
    <h1>Building agentic AI systems that ship to production.</h1>
    <p class="lead">
      I design LLM-powered automation — multi-agent workflows, RAG pipelines, and ML-driven decision
      systems — currently building AI-driven SOC automation at Krya Solutions.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/projects/')}>{t('home.viewProjects')}</a>
      <a class="text-link" href={withBase('/contact/')}>Get in touch →</a>
    </div>
    <div class="hero-cards">
      <a class="glass-card" href={withBase('/experience/')}>
        <p class="glass-card-label">Now</p>
        <p class="glass-card-value">1,000+</p>
        <p class="glass-card-note">live SIEM alerts/day · AI/ML Engineer at Krya Solutions</p>
      </a>
      <a class="glass-card" href={withBase('/projects/')}>
        <p class="glass-card-label">Projects</p>
        <p class="glass-card-value">{allProjects.length}</p>
        <p class="glass-card-note">agentic AI, RAG &amp; deep learning builds</p>
      </a>
      <a class="glass-card" href={withBase('/publications/')}>
        <p class="glass-card-label">Research</p>
        <p class="glass-card-value">94.02%</p>
        <p class="glass-card-note">voice pathology accuracy · IEEE ICIRCA 2025</p>
      </a>
      {
        latestProject && (
          <a class="glass-card" href={withBase(`/projects/${latestProject.id}/`)}>
            <p class="glass-card-label">Latest build</p>
            <p class="glass-card-title">{latestProject.data.title}</p>
            <ul class="glass-card-tags">
              {latestProject.data.tech.slice(0, 2).map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </a>
        )
      }
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">Focus areas</p>
      <h2>LLMs, agents, and applied ML.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Agentic AI</h3>
        <p>
          Multi-agent workflows with LangGraph and CrewAI, from ReAct agents to scheduled pipelines.
        </p>
      </article>
      <article>
        <h3>RAG &amp; retrieval</h3>
        <p>Vector-search pipelines grounded in real data — pgvector, FAISS, semantic matching.</p>
      </article>
      <article>
        <h3>Applied ML</h3>
        <p>Deep learning and anomaly detection, from CNN ensembles to Isolation Forest models.</p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestProjectsEyebrow')}</p>
      <h2 id="latest-works">Built records.</h2>
      <a class="text-link" href={withBase('/projects/')}>{t('home.allProjects')}</a>
    </div>

    {
      projects.length > 0 ? (
        <div class="highlight-grid">
          {projects.map((project) => (
            <article class="highlight-card">
              {project.data.thumbnail && (
                <Image
                  src={project.data.thumbnail}
                  alt=""
                  width={720}
                  height={480}
                  loading="lazy"
                />
              )}
              <div>
                <p class="meta">{formatDate(project.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a>
                </h3>
                <p>{project.data.description}</p>
                {project.data.tech.length > 0 && (
                  <ul
                    class="tag-list"
                    aria-label={t('home.projectTech', { title: project.data.title })}
                  >
                    {project.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.projectsEmpty')} />
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">Field notes.</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <Timeline items={timelineItems} />
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Hover "water" for the hero glass cards: a spring-driven liquid front that
  // surges from the top-left corner to the bottom-right, with a sloshing
  // surface (1D spring columns), a foam line and a lighter spray layer.
  // Draining on leave runs the same physics in reverse.
  const COLS = 32;
  const MARGIN = 28;

  type Rgb = [number, number, number];

  const parseColor = (value: string): Rgb => {
    const hex = value.trim().replace('#', '');
    const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
    const n = parseInt(full, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };
  const mix = (a: Rgb, b: Rgb, t: number): Rgb =>
    a.map((v, i) => Math.round(v + (b[i] - v) * t)) as Rgb;
  const rgba = ([r, g, b]: Rgb, a = 1) => `rgba(${r}, ${g}, ${b}, ${a})`;

  function setupWater(card: HTMLElement) {
    if (card.querySelector('.glass-card-water')) return;
    const canvas = document.createElement('canvas');
    canvas.className = 'glass-card-water';
    canvas.setAttribute('aria-hidden', 'true');
    card.prepend(canvas);
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heights = new Float32Array(COLS);
    const speeds = new Float32Array(COLS);

    // Geometry: `d` is the travel direction (top-left → bottom-right), `u` runs
    // along the water front. Positions are projections from the card centre.
    let w = 0,
      h = 0,
      cx = 0,
      cy = 0,
      dx = 0,
      dy = 0,
      ux = 0,
      uy = 0;
    let dMin = 0,
      dMax = 0,
      uMin = 0,
      uMax = 0;
    let front = 0,
      frontV = 0,
      spray = 0,
      sprayV = 0,
      target = 0;
    let energy = 0,
      time = 0;
    let deep: Rgb = [0, 0, 0],
      surface: Rgb = [0, 0, 0];

    const measure = () => {
      const dpr = window.devicePixelRatio || 1;
      w = card.offsetWidth;
      h = card.offsetHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = w / 2;
      cy = h / 2;
      const len = Math.hypot(w, h);
      dx = w / len;
      dy = h / len;
      ux = -dy;
      uy = dx;
      const corners = [
        [-cx, -cy],
        [cx, -cy],
        [cx, cy],
        [-cx, cy],
      ];
      const ds = corners.map(([x, y]) => x * dx + y * dy);
      const us = corners.map(([x, y]) => x * ux + y * uy);
      dMin = Math.min(...ds) - MARGIN;
      dMax = Math.max(...ds) + MARGIN;
      uMin = Math.min(...us) - 4;
      uMax = Math.max(...us) + 4;

      const styles = getComputedStyle(card);
      const accent = parseColor(styles.getPropertyValue('--color-accent'));
      const text = parseColor(styles.getPropertyValue('--color-text'));
      deep = mix(accent, text, 0.3);
      surface = mix(accent, [255, 255, 255], 0.22);
    };

    const point = (u: number, d: number): [number, number] => [
      cx + ux * u + dx * d,
      cy + uy * u + dy * d,
    ];

    const drawLayer = (edge: number, phase: number, fill: string | CanvasGradient) => {
      const amp = 2 + Math.min(energy * 2.2, 8);
      ctx.beginPath();
      for (let i = 0; i < COLS; i++) {
        const u = uMin + ((uMax - uMin) * i) / (COLS - 1);
        const ripple =
          Math.sin(time * 3.1 + i * 0.55 + phase) * amp +
          Math.sin(time * 1.7 - i * 0.31 + phase * 2) * amp * 0.5;
        const [x, y] = point(u, edge + heights[i] + ripple);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      const back = dMin - 400;
      ctx.lineTo(...point(uMax, back));
      ctx.lineTo(...point(uMin, back));
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
    };

    const step = () => {
      time += 1 / 60;

      // Front and spray are damped springs, so the water surges, slightly
      // overshoots, and settles like a liquid instead of easing linearly.
      frontV += (target - front) * 0.0014 - frontV * 0.052;
      front += frontV;
      sprayV += (target + (target > dMin ? 10 : 0) - spray) * 0.0018 - sprayV * 0.057;
      spray += sprayV;
      energy = Math.max(energy * 0.965, Math.abs(frontV));

      // Surface columns: springs pulled flat, kicked by the front's motion,
      // with neighbour spreading so disturbances travel along the edge.
      for (let i = 0; i < COLS; i++) {
        speeds[i] += -0.025 * heights[i] - 0.05 * speeds[i];
        speeds[i] += (Math.random() - 0.5) * Math.abs(frontV) * 0.12;
        heights[i] += speeds[i];
      }
      for (let pass = 0; pass < 4; pass++) {
        for (let i = 0; i < COLS; i++) {
          if (i > 0) speeds[i - 1] += (heights[i] - heights[i - 1]) * 0.22;
          if (i < COLS - 1) speeds[i + 1] += (heights[i] - heights[i + 1]) * 0.22;
        }
      }

      card.classList.toggle('is-wet', (front - dMin) / (dMax - dMin) > 0.55);
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      if (front <= dMin + 1 && spray <= dMin + 1) return;

      drawLayer(spray, 1.3, rgba(surface, 0.35));

      const [gx0, gy0] = point(0, front);
      const [gx1, gy1] = point(0, front - (dMax - dMin));
      const gradient = ctx.createLinearGradient(gx0, gy0, gx1, gy1);
      gradient.addColorStop(0, rgba(surface));
      gradient.addColorStop(0.35, rgba(mix(surface, deep, 0.5)));
      gradient.addColorStop(1, rgba(deep));
      drawLayer(front, 0, gradient);

      // Foam line just behind the leading edge.
      ctx.save();
      ctx.clip();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.restore();
    };

    let raf = 0;
    const settled = () =>
      Math.abs(target - front) < 0.5 &&
      Math.abs(frontV) < 0.05 &&
      Math.abs(target - spray) < 12 &&
      energy < 0.05;

    // Fixed 60 Hz physics steps driven by elapsed time, so the fill takes the
    // same time on slow devices (fewer frames) as on fast ones.
    const STEP_MS = 1000 / 60;
    let last = 0;
    let pending = 0;
    const loop = (now: number) => {
      pending += last ? Math.min(now - last, 100) : STEP_MS;
      last = now;
      while (pending >= STEP_MS) {
        step();
        pending -= STEP_MS;
      }
      draw();
      if (settled()) {
        raf = 0;
        last = 0;
        pending = 0;
      } else {
        raf = requestAnimationFrame(loop);
      }
    };

    const pour = (fill: boolean) => {
      if (!w) {
        measure();
        front = spray = target = dMin;
      } else if (fill) {
        measure();
      }
      target = fill ? dMax : dMin;
      if (reduceMotion) {
        front = spray = target;
        frontV = sprayV = energy = 0;
        card.classList.toggle('is-wet', fill);
        draw();
        return;
      }
      if (!raf) raf = requestAnimationFrame(loop);
    };

    card.addEventListener('pointerenter', () => pour(true));
    card.addEventListener('pointerleave', () => pour(false));
    card.addEventListener('focus', () => pour(true));
    card.addEventListener('blur', () => pour(false));
  }

  // Re-run after view-transition navigations, which swap in fresh cards.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.hero-cards .glass-card').forEach(setupWater);
  });
</script>
